---
/**
 * Starlight's footer, plus the version switcher this site has always carried.
 *
 * Every published release keeps its own copy of the site at
 * /liminis-context-graph/vX.Y.Z/, with the latest stable also at the root
 * (ADR-0477). The switcher is how a reader gets from one to another, and
 * without it the older copies exist but are unreachable.
 *
 * Ported from the Jekyll layout it replaces, behaviour intact.
 */
import Default from '@astrojs/starlight/components/Footer.astro'

const version = import.meta.env.PUBLIC_DOCS_VERSION
---

<Default><slot /></Default>

<p class="lcg-version">
  Documents <code>liminis-context-graph</code> v{version}.
  <span id="version-switcher"></span>
</p>

<script>
  // Fetched from a fixed root-relative path, not through the site's base: a
  // versioned build would otherwise resolve this to a per-version copy that does
  // not exist. The manifest only ever lives at the root, regenerated by
  // docs-publish-build.sh from what is actually published.
  fetch('/liminis-context-graph/versions.json')
    .then((res) => (res.ok ? res.json() : null))
    .then((data) => {
      if (!data || !Array.isArray(data.versions) || data.versions.length === 0) return

      const container = document.getElementById('version-switcher')
      if (!container) return

      const select = document.createElement('select')
      select.setAttribute('aria-label', 'Switch documented version')

      // versions.json includes prereleases (they get their own versioned URL but
      // never become root — see ADR-0477), so versions[0] may be a prerelease.
      // The root always serves the latest *stable* release, so the label has to
      // match: the first version with no "-" suffix.
      const stable = data.versions.filter((v: string) => !v.includes('-'))
      const latestStable = stable.length > 0 ? stable[0] : data.versions[0]

      const latest = document.createElement('option')
      latest.value = '/liminis-context-graph/'
      latest.textContent = `latest (v${latestStable})`
      select.appendChild(latest)

      for (const v of data.versions) {
        const option = document.createElement('option')
        option.value = `/liminis-context-graph/v${v}/`
        option.textContent = `v${v}`
        if (window.location.pathname.startsWith(option.value)) option.selected = true
        select.appendChild(option)
      }

      select.addEventListener('change', () => {
        window.location.href = select.value
      })

      container.appendChild(select)
    })
    // versions.json is absent on a local build, and on the very first publish
    // before any version has accumulated. No switcher, no error.
    .catch(() => {})
</script>

<style>
  .lcg-version {
    margin-top: 1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .lcg-version select {
    margin-inline: 0.4rem;
    font-size: var(--sl-text-xs);
  }
</style>
