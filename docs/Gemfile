source "https://rubygems.org"

# Ruby 3.4+ dropped csv from the default gems bundled with the interpreter; the
# github-pages gem's pinned Jekyll 3.x still expects to `require "csv"` unconditionally.
# Harmless on older Rubies (including CI's, see docs-drift.yml) where it's already a
# default gem.
gem "csv"

gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-relative-links"
end

# CI-only: internal link checking (see .github/workflows/docs-drift.yml). Never
# reaches the GitHub Pages build itself, which ignores this group.
group :ci do
  gem "html-proofer"
end
